if ! pdns_server --config=check &> /run/pdns_check.log
	then
		logger -t pdns "ERROR: PowerDNS config failed check"
		logger -t pdns < /run/pdns_check.log
		sleep 5
		exit 1
	fi

exec /usr/sbin/pdns_server 2>&1 | logger -t pdns
